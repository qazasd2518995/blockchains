{
  "name": "@bg/server",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "tsx watch src/index.ts",
    "build": "prisma generate && tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "echo \"(server lint skipped)\"",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "prisma": "prisma",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:generate": "prisma generate",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:agent": "tsx prisma/seed-agent.ts",
    "db:seed:qmoney": "tsx prisma/seed-qmoney.ts",
    "db:reset-admin": "tsx prisma/reset-super-admin.ts",
    "db:set-admin-balance": "tsx prisma/set-super-admin-balance.ts"
  },
  "dependencies": {
    "@bg/provably-fair": "workspace:*",
    "@bg/shared": "workspace:*",
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/jwt": "^10.2.2",
    "@fastify/rate-limit": "^11.2.0",
    "@prisma/client": "^5.19.0",
    "bcrypt": "^6.0.0",
    "decimal.js": "^10.4.3",
    "dotenv": "^16.4.5",
    "fastify": "^5.12.3",
    "fastify-plugin": "^6.0.0",
    "pino-pretty": "^11.2.2",
    "prisma": "^5.19.0",
    "socket.io": "^4.8.3",
    "tsx": "^4.23.13",
    "typescript": "^5.5.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@bg/tsconfig": "workspace:*",
    "@types/bcrypt": "^6.0.0",
    "@types/node": "^20.12.0",
    "supertest": "^7.0.0",
    "@types/supertest": "^6.0.2",
    "vitest": "^2.0.0"
  }
